{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "tag": {
          "enum": [
            "front_view",
            "logo",
            "human_interaction",
            "rich_environment",
            "side_view",
            "back_view",
            "surface_detail",
            "interior_visible",
            "closure_detail",
            "carried_or_worn",
            "multi_pack",
            "combo",
            "ignore"
          ],
          "title": "Tag",
          "type": "string"
        },
        "detail": {
          "description": "Brief visible support or exact uncertainty; no chain of thought",
          "title": "Detail",
          "type": "string"
        },
        "basis": {
          "enum": [
            "actual_product",
            "actual_contents",
            "packaging_depiction",
            "application_result",
            "human_contact",
            "scene",
            "unclear"
          ],
          "title": "Basis",
          "type": "string"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional location within the image, e.g. left panel",
          "title": "Region"
        }
      },
      "required": [
        "tag",
        "detail",
        "basis",
        "region"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ImageAssessment": {
      "additionalProperties": false,
      "properties": {
        "image_id": {
          "title": "Image Id",
          "type": "string"
        },
        "variant_ids": {
          "description": "All visibly supported listing variants; [] if none",
          "items": {
            "type": "string"
          },
          "title": "Variant Ids",
          "type": "array"
        },
        "product_match": {
          "enum": [
            "matched",
            "uncertain",
            "mismatch",
            "no_product"
          ],
          "title": "Product Match",
          "type": "string"
        },
        "quality": {
          "enum": [
            "usable",
            "limited",
            "unusable"
          ],
          "title": "Quality",
          "type": "string"
        },
        "duplicate_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Earlier image ID only for a redundant view; null otherwise",
          "title": "Duplicate Of"
        },
        "tags": {
          "$ref": "#/$defs/ProductTags"
        },
        "evidence": {
          "description": "Evidence for every positive/value observation; false needs none, null may explain uncertainty",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "image_id",
        "variant_ids",
        "product_match",
        "quality",
        "duplicate_of",
        "tags",
        "evidence",
        "limitations"
      ],
      "title": "ImageAssessment",
      "type": "object"
    },
    "ProductTags": {
      "additionalProperties": false,
      "properties": {
        "front_view": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Identify the product’s visible front or principal face, including its actual packaging front; do not guess orientation from an ambiguous crop. Use null when uncertain.",
          "title": "Front View"
        },
        "logo": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Identify a visible brand mark on the actual product or packaging; exclude watermarks, promotional overlays and branding on unrelated props. Use null when uncertain.",
          "title": "Logo"
        },
        "human_interaction": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Identify visible human contact with the actual product, such as holding, touching or carrying; a nearby person alone is insufficient. Use null when uncertain.",
          "title": "Human Interaction"
        },
        "rich_environment": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Identify the product or attributable application/result in a relevant setting with visible contextual detail; a plain backdrop alone does not qualify. Use null when uncertain.",
          "title": "Rich Environment"
        },
        "side_view": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Identify a visibly supported side/profile surface; a three-quarter image may also show a front or back surface. Use null when uncertain.",
          "title": "Side View"
        },
        "back_view": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Identify the visible rear/reverse surface from actual construction; do not infer it from symmetry or an ambiguous pose. Use null when uncertain.",
          "title": "Back View"
        },
        "surface_detail": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Identify a recognizable close-up of product texture, finish, colour, joins or construction; do not infer material composition. Use null when uncertain.",
          "title": "Surface Detail"
        },
        "interior_visible": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Identify a genuine view into the item’s open storage space, showing actual lining, slots or compartments. Use null when uncertain.",
          "title": "Interior Visible"
        },
        "closure_detail": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Identify actual visible zips, clasps, drawcords, hinges or clips in their pictured state; do not infer hidden mechanisms. Use null when uncertain.",
          "title": "Closure Detail"
        },
        "carried_or_worn": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Identify the actual item visibly carried, worn or pulled as appropriate to its design; do not infer capacity or fit. Use null when uncertain.",
          "title": "Carried Or Worn"
        },
        "multi_pack": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Identify separate products of the same kind shown as a catalog assortment, including variants; exclude repeated views of one item, unrelated props and packaging art mistaken for units. Use null when uncertain.",
          "title": "Multi Pack"
        },
        "combo": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Identify different product types visibly represented together as a catalog set, supported by item context; exclude unrelated props, duplicate views and packaging art mistaken for actual items. Use null when uncertain.",
          "title": "Combo"
        },
        "ignore": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Ignore only when neither the catalog product nor an attributable application/result or contents depiction is identifiable, or dominant text prevents assessing that evidence. Unbranded items are valid. Use null when uncertain.",
          "title": "Ignore"
        }
      },
      "required": [
        "front_view",
        "logo",
        "human_interaction",
        "rich_environment",
        "side_view",
        "back_view",
        "surface_detail",
        "interior_visible",
        "closure_detail",
        "carried_or_worn",
        "multi_pack",
        "combo",
        "ignore"
      ],
      "title": "ProductTags",
      "type": "object"
    },
    "SelectedReference": {
      "additionalProperties": false,
      "properties": {
        "image_id": {
          "title": "Image Id",
          "type": "string"
        },
        "roles": {
          "description": "Supported non-null observations assigned to this reference",
          "items": {
            "enum": [
              "front_view",
              "logo",
              "human_interaction",
              "rich_environment",
              "side_view",
              "back_view",
              "surface_detail",
              "interior_visible",
              "closure_detail",
              "carried_or_worn",
              "multi_pack",
              "combo",
              "ignore"
            ],
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "image_id",
        "roles",
        "reason"
      ],
      "title": "SelectedReference",
      "type": "object"
    },
    "Variant": {
      "additionalProperties": false,
      "properties": {
        "variant_id": {
          "title": "Variant Id",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "image_ids": {
          "items": {
            "type": "string"
          },
          "title": "Image Ids",
          "type": "array"
        }
      },
      "required": [
        "variant_id",
        "description",
        "image_ids"
      ],
      "title": "Variant",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assessments": {
      "items": {
        "$ref": "#/$defs/ImageAssessment"
      },
      "title": "Assessments",
      "type": "array"
    },
    "variants": {
      "items": {
        "$ref": "#/$defs/Variant"
      },
      "title": "Variants",
      "type": "array"
    },
    "selected_variant_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Selected Variant Id"
    },
    "selected_references": {
      "items": {
        "$ref": "#/$defs/SelectedReference"
      },
      "title": "Selected References",
      "type": "array"
    },
    "unresolved": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved",
      "type": "array"
    }
  },
  "required": [
    "assessments",
    "variants",
    "selected_variant_id",
    "selected_references",
    "unresolved"
  ],
  "title": "ImagePickerResult",
  "type": "object"
}
